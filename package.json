{
  "name": "hookgres",
  "version": "0.5.1",
  "description": "Transactional outbox for webhooks on Postgres: webhook delivery that commits with your data. Signed with Standard Webhooks, retried, logged. TypeScript, no extra infrastructure.",
  "keywords": [
    "webhooks",
    "postgres",
    "postgresql",
    "standard-webhooks",
    "outbox",
    "delivery",
    "retries",
    "svix-alternative",
    "postgres-webhooks",
    "pg-webhooks",
    "webhooks-postgres",
    "transactional-outbox"
  ],
  "license": "MIT",
  "author": "Nikos Benakis (https://github.com/NickolasBenakis)",
  "bugs": {
    "url": "https://github.com/NickolasBenakis/hookgres/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kysely": {
      "types": "./dist/kysely.d.ts",
      "default": "./dist/kysely.js"
    },
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "default": "./dist/prisma.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "llms": "node scripts/agent-docs.mjs",
    "prepack": "node scripts/agent-docs.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p examples",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "bench": "pnpm build && node scripts/load-test.ts",
    "db-cost": "pnpm build && node scripts/db-cost.ts",
    "examples": "pnpm build && node scripts/check-examples.mjs",
    "playground": "pnpm build && node examples/playground/server.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "site:build": "node scripts/build-site.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "changeset": "changeset",
    "ci:version": "changeset version && biome format --write CHANGELOG.md",
    "ci:publish": "changeset publish"
  },
  "peerDependencies": {
    "kysely": ">=0.27.0",
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@mikro-orm/core": "^7.2.8",
    "@mikro-orm/postgresql": "^7.2.8",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/instrumentation-undici": "^0.35.0",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "arktype": "^2.2.9",
    "drizzle-orm": "^0.45.4",
    "knex": "^3.3.0",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "postgres": "^4.1.0",
    "sequelize": "^6.37.8",
    "standardwebhooks": "^1.1.1",
    "testcontainers": "^12.2.1",
    "typeorm": "^1.1.2",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitepress": "1.6.4",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@10.33.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NickolasBenakis/hookgres.git"
  },
  "homepage": "https://github.com/NickolasBenakis/hookgres#readme",
  "sideEffects": false,
  "pnpm": {
    "overrides": {
      "vitepress>vite": "^6.4.4",
      "esbuild@<0.25.0": "^0.25.0",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
      "uuid@<11.1.1": "^11.1.1"
    }
  }
}
