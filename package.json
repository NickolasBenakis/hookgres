{
  "name": "hookgres",
  "version": "0.2.0",
  "description": "Hookgres: webhooks that commit with your data. Signed, retried, logged webhooks queued in your own Postgres transaction. TypeScript, no extra infrastructure.",
  "keywords": [
    "webhooks",
    "postgres",
    "postgresql",
    "standard-webhooks",
    "outbox",
    "delivery",
    "retries",
    "svix-alternative",
    "postgres-webhooks",
    "pg-webhooks",
    "webhooks-postgres",
    "transactional-outbox"
  ],
  "license": "MIT",
  "author": "Nikos Benakis (https://github.com/NickolasBenakis)",
  "bugs": {
    "url": "https://github.com/NickolasBenakis/hookgres/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p examples",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "bench": "pnpm build && node scripts/load-test.ts",
    "examples": "pnpm build && node scripts/check-examples.mjs",
    "playground": "pnpm build && node examples/playground/server.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "site:build": "node scripts/build-site.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:publish": "changeset publish"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "pg": "^8.23.1",
    "standardwebhooks": "^1.1.1",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2",
    "vitepress": "1.6.4",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NickolasBenakis/hookgres.git"
  },
  "homepage": "https://github.com/NickolasBenakis/hookgres#readme",
  "sideEffects": false,
  "pnpm": {
    "overrides": {
      "vitepress>vite": "^6.4.4",
      "esbuild@<0.25.0": "^0.25.0",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  }
}
