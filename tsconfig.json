{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node"],
    // Docs snippets import "hookgres"; check them against the source.
    "paths": { "hookgres": ["./src/index.ts"] }
  },
  "include": ["src", "test", "docs/snippets", "vitest.config.ts"],
  "exclude": ["examples", "scripts"]
}
